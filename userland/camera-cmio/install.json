{
  "component": "camera-cmio",
  "note": "Installed under bin/ (the add-on's /private/var/ngpu/bin): the boot add-on cannot make a new folder directly under /Library. The extension ships inside the host app only, where the system looks for it (Contents/Library/SystemExtensions). 'nested' names it so that scripts/package-userland.py signs it as a bundle of its own (identifier and entitlements of its own) before the app around it.",
  "products": [
    {
      "path": "IcelandCameraHost.app",
      "identifier": "org.iceland.camera.host",
      "install": "bin/IcelandCameraHost.app",
      "entitlements": "host/host.entitlements",
      "nested": [
        {
          "path": "Contents/Library/SystemExtensions/org.iceland.camera.extension.systemextension",
          "identifier": "org.iceland.camera.extension",
          "entitlements": "extension.entitlements"
        }
      ],
      "executables": [
        "Contents/MacOS/IcelandCameraHost",
        "Contents/Library/SystemExtensions/org.iceland.camera.extension.systemextension/Contents/MacOS/IcelandCamera"
      ]
    },
    {
      "path": "iceland-camera-probe",
      "identifier": "org.iceland.camera-probe",
      "install": "bin/iceland-camera-probe",
      "entitlements": "probe/probe.entitlements"
    },
    {
      "path": "iceland-camera-ui",
      "identifier": "org.iceland.camera-ui",
      "install": "bin/iceland-camera-ui",
      "entitlements": "ui/ui.entitlements"
    }
  ]
}
