<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Ours (MIT). The extension's entitlements: sandboxed, with the app group whose identifier prefixes
     Info.plist's CMIOExtensionMachServiceName (the documented rule for that name) and the one IOKit user client class
     it opens, the in-kernel camera driver's. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>org.iceland.camera</string>
	</array>
	<key>com.apple.security.temporary-exception.iokit-user-client-class</key>
	<array>
		<string>IcelandCameraUserClient</string>
	</array>
</dict>
</plist>
