# AdrenoMetal (macOS): boot-arg agx-half-each=1 sets NATIVE_METAL_HALF_EACH=1, and the bridge then opens the device with
# half_chains = HalfChainPolicy::EachOperation. iceland's own code (MIT, as the files it patches); the fact is upstream's
# (UniXNU/AdrenoMetal ce37cbc, branch fix/runtime-development-d923, which sets it for every device, after ce8986f: RelaxedPrecision on
# composite half operations "can overflow half intermediates despite a finite half result"). On Turnip (shaderFloat16, no 16-bit
# DenormPreserve) the default, AtExits, leaves each half operation the GPU has an instruction for to its own 16-bit registers
# (runtime patch 0040, narrow::relaxes); EachOperation states it in float with a conversion to 16 bits and back, which Mesa folds
# away, so the arithmetic runs unrounded on 32-bit registers. A comparison switch for Core Image's and the icon agent's output, off
# by default. The device profile carries the choice, so each value has its own shader cache entries; the priming progress does not,
# so a first boot with the switch translates at first use. Applies after adrenometal-ci-mps.patch.
diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
index 6d9bc30..b6500c4 100644
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -364,6 +364,13 @@ static id deviceForPort(unsigned port) {
         // same image. Read by the bridge as the device opens.
         if (bootArgSet("gpu-purge=0")) setenv("NATIVE_METAL_PURGE", "0", 1);
         else unsetenv("NATIVE_METAL_PURGE");
+#if TARGET_OS_OSX
+        // iceland (macOS): agx-half-each=1 has the translator state every half operation in float and convert it to 16 bits and back
+        // (HalfChainPolicy::EachOperation) instead of leaving it to the GPU's 16-bit registers (RelaxedPrecision), for a comparison on
+        // the same image. Read by the bridge as the device opens.
+        if (bootArgSet("agx-half-each=1")) setenv("NATIVE_METAL_HALF_EACH", "1", 1);
+        else unsetenv("NATIVE_METAL_HALF_EACH");
+#endif
         // gpu-ycbcr-planes=0: every two-plane YCbCr surface texture is made with its converted image, as before bridge patch 0035,
         // for a comparison on the same image. Read by the bridge at the first such texture.
         if (bootArgSet("gpu-ycbcr-planes=0")) setenv("NATIVE_METAL_YCBCR_PLANES", "0", 1);
diff --git a/bridge/NativeMetalObjects.rs b/bridge/NativeMetalObjects.rs
index ef86e60..e2f69d7 100644
--- a/bridge/NativeMetalObjects.rs
+++ b/bridge/NativeMetalObjects.rs
@@ -267,6 +267,13 @@ pub unsafe extern "C" fn nmb_device_open(loader: *const c_char, cache: *const c_
         // server's surfaces and padded framebuffers (3048x2032 BGRA8 at 12288-byte rows, int-251) were otherwise copied in and out of a
         // shadow image every pass.
         options.policy.host_page_textures = metal2vulkan::device::HostPageTexturePolicy::InPlaceWrites;
+        // iceland: `NATIVE_METAL_HALF_EACH=1` (the boot argument `agx-half-each=1`) states every `half` operation in `float` with its
+        // conversion to 16 bits and back, where the default (`AtExits`) leaves it to the GPU's own 16-bit precision (`RelaxedPrecision`,
+        // runtime patch 0040); upstream ce37cbc sets it for every device after ce8986f found half intermediates overflowing in composite
+        // operations. The profile carries the choice, so each value has its own shader cache entries.
+        if std::env::var_os("NATIVE_METAL_HALF_EACH").is_some_and(|value| value == "1") {
+            options.policy.half_chains = metal2vulkan::device::HalfChainPolicy::EachOperation;
+        }
         // Metal makes a pipeline state's pipeline at its creation and never drops a draw for a pipeline being made; the runtime's
         // default (PipelineWaitPolicy::Bounded) drops the draws and dispatches of a pipeline not made 4.5 s after the commit, which the
         // render server showed as missing pieces of the screen while it compiled (int 590aaee2).
