+/* Why a GPU memory request was refused (iceland gains1): [0] va, no free range in the process's GPU window (darwin_allocate_iova);
+ * [1] map, the kernel refused the mapping (BoMap: its tables or its span capacity, darwin_map_failure); [2] heap, Turnip's heap
+ * accounting (tu_add_to_heap; the heap is capped at the window). One unified-log line per kind each time its count reaches a power of
+ * two. The counts and the calling thread's last refused kind (plus one; cleared when it is read and when a host import begins) are
+ * exported for the Metal plugin, which tells by them which path refused its surface import (tu_darwin_refusal_stats). */
+static uint64_t darwin_refusals[3];
+static thread_local unsigned darwin_last_refusal;
+extern "C" __attribute__((visibility("default"))) void tu_darwin_refusal_stats(uint64_t out[4]);
+extern "C" __attribute__((visibility("default"))) void
+tu_darwin_refusal_stats(uint64_t out[4])
+{
+   for (unsigned i = 0; i < 3; ++i)
+      out[i] = p_atomic_read(&darwin_refusals[i]);
+   out[3] = darwin_last_refusal;
+   darwin_last_refusal = 0;
+}
+extern "C" void tu_darwin_note_refusal(unsigned kind, uint64_t size, uint64_t a, uint64_t b);
+extern "C" void
+tu_darwin_note_refusal(unsigned kind, uint64_t size, uint64_t a, uint64_t b)
+{
+   static const char *const names[3] = {"va (no GPU range; used, window)", "map (BoMap refused; kr, iova)",
+                                        "heap (heap accounting; used, size)"};
+   if (kind > 2)
+      return;
+   darwin_last_refusal = kind + 1;
+   const uint64_t n = p_atomic_inc_return(&darwin_refusals[kind]);
+   if (n & (n - 1))
+      return;
+   os_log(OS_LOG_DEFAULT, "NativeAdreno refused %{public}s: %llu so far (va %llu map %llu heap %llu), %llu B, %#llx %#llx",
+          names[kind], (unsigned long long)n, (unsigned long long)p_atomic_read(&darwin_refusals[0]),
+          (unsigned long long)p_atomic_read(&darwin_refusals[1]), (unsigned long long)p_atomic_read(&darwin_refusals[2]),
+          (unsigned long long)size, (unsigned long long)a, (unsigned long long)b);
+}
+static void
+darwin_note_va_refusal(struct tu_device *dev, uint64_t size)
+{
+   pthread_mutex_lock(&darwin_process_va_lock);
+   const uint64_t used = darwin_process_va.used;
+   pthread_mutex_unlock(&darwin_process_va_lock);
+   tu_darwin_note_refusal(0, size, used, dev->physical_device->va_size);
+}
+
 static VkResult
 darwin_map_failure(struct tu_device *dev, uint64_t handle, uint64_t iova,
                    uint64_t size, kern_return_t map_error, bool own_iova = true)
 {
+   tu_darwin_note_refusal(1, size, (uint64_t)(uint32_t)map_error, iova);
    NativeAdrenoAbiBoFree release = {.handle = handle};
    kern_return_t cleanup = dw_call(NativeAdrenoMethodBoFree, &release, sizeof(release), NULL, 0);
    if (cleanup == KERN_SUCCESS) {
@@ -921,6 +965,8 @@ darwin_bo_init(struct tu_device *dev, struct vk_object_base *base,
          if (any)
             continue;
       }
+      if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY)
+         darwin_note_va_refusal(dev, alloc_size);
       if (result != VK_SUCCESS)
          return result;
 
@@ -1004,11 +1050,25 @@ darwin_bo_init_host(struct tu_device *dev, struct tu_bo **out_bo, void *pointer,
 {
    if (!(dw.params.flags & NativeAdrenoParamsHostImport))
       return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   darwin_last_refusal = 0;   /* this import's refusal, if any, is the one the caller reads */
    VkResult collected = darwin_collect_retired(dev);
    if (collected != VK_SUCCESS)
       return collected;
    uint64_t iova;
    VkResult result = darwin_allocate_iova(dev, size, 0, TU_BO_ALLOC_NO_FLAGS, &iova);
+   if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY) {
+      /* No GPU range for the import: the cached BOs may hold the window (iceland gains1 F2). Everything cached goes back and the
+       * range is asked for once more, as darwin_bo_init does when its range or its allocation fails; without it the import failed
+       * while freed BOs kept their ranges, and the render server left that surface's layer undrawn (OutOfMemory(Device)). */
+      struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+      pthread_mutex_lock(&retire->lock);
+      bool any = darwin_cache_flush(dev, retire);
+      pthread_mutex_unlock(&retire->lock);
+      if (any)
+         result = darwin_allocate_iova(dev, size, 0, TU_BO_ALLOC_NO_FLAGS, &iova);
+      if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY)
+         darwin_note_va_refusal(dev, size);
+   }
    if (result != VK_SUCCESS)
       return result;
 
