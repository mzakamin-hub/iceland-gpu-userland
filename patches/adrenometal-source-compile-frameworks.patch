# AdrenoMetal: a runtime MSL compile (MTLDevice newLibraryWithSource:) gets the framework search paths, the caller's
# arguments, and (18 Nov, r2507-pbfix) the add-on's carved Core Image private-header directory: CIKernelMetalLibPrivate.h
# exists nowhere on macOS 27.3 as a file (its text is inside CoreImage's binary), so the add-on installs the carved text
# under /private/var/ngpu/ci-headers and this adds that directory to the compile's search. Ours, MIT as the file it
# patches; applies unchanged on AdrenoMetal main 8c7f950 (R2507).
diff --git a/NativeBridgeMetalFrontend.mm b/NativeBridgeMetalFrontend.mm
index e9aceb2..7022116 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -918,6 +918,20 @@ static NSString *compileArguments(MTLCompileOptions *options) {
   [arguments addObject:compileArgument([NSString stringWithFormat:@"-D%@=%@",name,value])];
  }];
  [arguments addObject:compileArgument([@"-fmodules-cache-path=" stringByAppendingString:[NSTemporaryDirectory() stringByAppendingPathComponent:@"m2v-msl"]])];
+ // A source that includes framework headers ("'CIKernelMetalLib.h' file not found" from Photo Booth's Core Image kernels): the system
+ // frameworks for <Framework/Header.h> and Core Image's own headers directory, as MTLCompilerService finds them.
+ [arguments addObject:@"-F/System/Library/Frameworks"];
+ [arguments addObject:@"-I/System/Library/Frameworks/CoreImage.framework/Headers"];
++[arguments addObject:@"-I/private/var/ngpu/ci-headers"];   /* w7-cam: CIKernelMetalLibPrivate.h carved from CoreImage's binary, installed by the add-on */
+ // The caller's own arguments where its options carry some (private SPI, asked first): its include paths and flags are what the
+ // kernels expect, and a client that sets none passes none.
+ for(NSString *name in @[@"additionalCompilerArguments",@"compilerArguments"]) {
+  const SEL selector=NSSelectorFromString(name);
+  if(options && [options respondsToSelector:selector]) {
+   id extra=((id (*)(id,SEL))objc_msgSend)(options,selector);
+   if([extra isKindOfClass:[NSArray class]])for(id argument in (NSArray *)extra)if([argument isKindOfClass:[NSString class]])[arguments addObject:compileArgument(argument)];
+  }
+ }
  return [arguments componentsJoinedByString:@" "];
 }
 static NSError *nbError(NSString *why) {
@@ -4794,7 +4808,7 @@ static void reportUnreadableLibrary(NSString *path) {
  NSString *warnings=nil,*failure=nil;
  NSData *metallib=compileMetalSource(source,compileArguments(options),&warnings,&failure);
  if(!metallib) {
-  NBLOG(@"native-metal: newLibraryWithSource: %@ | compiler %s",[failure substringToIndex:MIN(failure.length,(NSUInteger)300)],gCompilerLoaded);
+  NBLOG(@"native-metal: newLibraryWithSource: %@ | compiler %s",[failure substringToIndex:MIN(failure.length,(NSUInteger)2000)],gCompilerLoaded);
   if(error)*error=[NSError errorWithDomain:MTLLibraryErrorDomain code:MTLLibraryErrorCompileFailure userInfo:@{NSLocalizedDescriptionKey:failure}];
   return nil;
  }
