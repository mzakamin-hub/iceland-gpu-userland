# Turnip smoke on macOS (S11 gpuu-1, our patch to AdrenoMetal at the pin 73d582f, MIT upstream): turnip::run defaults
# TU_DARWIN_SERVICE to IOAcceleratorES, iPadOS' accelerator (NativeTurnipSmoke.h:434, setenv without overwrite). In the plugin
# that is harmless (NativeAdrenoMetalPlugin.mm:398 sets AGXAccelerator first, overwriting), but adrenoprobed's Turnip phase
# (the t3 triangle, after its raw test) runs it with nothing set first and so opened a service macOS does not have. Under
# TARGET_OS_OSX the default is AGXAccelerator, the name the probe daemon's gate (adrenoprobed-macos-gate.patch) matches.
# Checked to apply at 73d582f, before or after the gate patch (they touch different files).
diff --git a/NativeTurnipSmoke.h b/NativeTurnipSmoke.h
index 4d17e26..3e9e166 100644
--- a/NativeTurnipSmoke.h
+++ b/NativeTurnipSmoke.h
@@ -12,6 +12,7 @@
 // "T s<stage> r<VkResult> v<fill words> c<compute words> g<triangle pixels>/<stray pixels> <first Vulkan error message>".
 #pragma once
 #define VK_NO_PROTOTYPES 1
+#include <TargetConditionals.h>
 #include <vulkan/vulkan_core.h>
 #include "SharedShaderCache.h"
 #include "NativeTurnipShaders.h"   // generated: scripts/gen-turnip-smoke-shaders.py
@@ -431,7 +432,12 @@ static Result run(Marker &&mark, const char *libraryPath) {
     };
     // The Darwin backend reaches the driver the same way the plugin does: the AGX accelerator service with open type 0x4147, ABI methods through
     // an admitted selector. The shader cache uses the same writable per-user directory as the Metal runtime.
+#if TARGET_OS_OSX
+    // macOS has no IOAcceleratorES: the kernel publishes AGXAccelerator, an IOAccelerator (the plugin sets the same, overwriting)
+    setenv("TU_DARWIN_SERVICE", "AGXAccelerator", 0);
+#else
     setenv("TU_DARWIN_SERVICE", "IOAcceleratorES", 0);
+#endif
     const std::string sharedCache = sharedShaderCacheDirectory();
     if (!sharedCache.empty()) configureShaderDiskCache(sharedCache);
     // Concurrent binning (BV running ahead of BR) is a performance feature; its barriers make BR wait for BV timestamps. int-058's
