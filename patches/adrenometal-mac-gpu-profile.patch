# AdrenoMetal (macOS): an optional Mac GPU profile, boot-arg agx-mac-profile=1 or NATIVE_METAL_MAC_PROFILE=1, off by default.
# iceland's own code (MIT, as the file it patches). Facts from macos-uke (gpu/plugin/0001-macos-windowserver.patch, eaa695a) and
# SnapMetal (8fe64cb, AdrenoMetal/AdrenoMTLDevice.m; MIT); nothing of either is copied. With Apple GPU families Core Image takes
# Apple-GPU paths this runtime cannot serve. With the profile: supportsFamily: is YES for Common1-3 and Mac2 only and featureProfile
# answers 10001 (Mac2 + Common1-3); function pointers, dynamic libraries, ray tracing, SIMD-group/quad-group operations, tile shaders,
# image blocks and memoryless targets answer NO; minimumLinearTextureAlignmentForPixelFormat: answers at least 64;
# iosurfaceReadOnlyTextureAlignmentBytes, iosurfaceTextureAlignmentBytes and deviceLinearReadOnlyTextureAlignmentBytes answer 16 (64
# there sent Core Image's blur into MPS with a nil source). Framebuffer fetch stays the runtime's own answer (yes on Turnip, through
# rasterization-order attachment access), as SnapMetal answers with this profile: with NO (this patch until 4f819e8) the tablet's first
# full-GPU desktop (run w3-combined-1-datareset, 15 Nov) drew round shapes as diamonds, no login clock and a dark, opaque menu bar,
# because Core Animation's corner restore, blur, backdrop and blended materials read the destination and without fetch still take
# that path. Boot-arg agx-mac-fetch=0 (NATIVE_METAL_MAC_FETCH=0) answers NO again and sets Core Animation's
# CA_DISABLE_GENERIC_SHADERS (its generic pipeline needs fetch), the earlier behaviour, to compare. Without agx-mac-profile=1 every
# answer is as before. Re-based onto AdrenoMetal main 8c7f950 (R2507, 17 Nov 2026) with no change to its hunks; it applies on the
# pin alone now (adrenometal-universal-library-entries.patch, after which it used to go, is upstream since R2507).
diff --git a/NativeBridgeMetalFrontend.mm b/NativeBridgeMetalFrontend.mm
index 8edc46b..2cdae93 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -4347,6 +4347,10 @@ static bool pipelineArchives(NSArray *list,std::vector<NmbBinaryArchive *> &arch
 @protocol NBOriginalStitching
 - (NSString *)newDagStringWithGraphs:(NSArray<MTLFunctionStitchingGraph *> *)graphs;
 @end
+#if TARGET_OS_OSX
+static uint64_t askAnswer(SEL cmd,NSUInteger arg);   // (iceland: below, with the device queries)
+static bool macProfile();
+#endif
 @interface NBDeviceMethods : NSObject
 @end
 static void fillBaseLimits(id device);
@@ -4362,7 +4366,18 @@ static void fillBaseLimits(id device);
 // SPI: the row alignment a read-only texture over an IOSurface needs. Answered unasked it was 0 (a divisor for its callers); the linear
 // texture alignment of the widest common format is the same rule this GPU applies to any linear image.
 - (NSUInteger)iosurfaceReadOnlyTextureAlignmentBytes {
+#if TARGET_OS_OSX
+ // iceland (macOS): the runtime's own answer, asked directly. With the Mac GPU profile the device's minimumLinearTextureAlignmentForPixelFormat:
+ // answers at least 64 (macProfile), and a 64-byte IOSurface alignment sent Core Image's blur into MPS with a nil source (macos-uke
+ // gpu/plugin/0001-macos-windowserver.patch, which keeps this answer at the runtime's for that reason). Without the profile nothing changes.
+ // With the profile it is 16, Metal's own and the runtime's IOSurface alignment (its iosurfaceReadOnlyTextureAlignmentBytes): the
+ // runtime's per-format linear answer can be 64 or more on this GPU, and 64 here sent Core Image's blur into MPSImageGaussianBlur with
+ // a nil source, an assertion abort (SnapMetal AdrenoMTLDevice.m, which leaves this to the base class for that reason).
+ if(macProfile())return 16;
+ return (NSUInteger)askAnswer(sel_registerName("minimumLinearTextureAlignmentForPixelFormat:"),MTLPixelFormatRGBA16Float);
+#else
  return ((NSUInteger (*)(id,SEL,NSUInteger))objc_msgSend)(self,sel_registerName("minimumLinearTextureAlignmentForPixelFormat:"),MTLPixelFormatRGBA16Float);
+#endif
 }
 - (uint64_t)registryID {return gRegistryID;}
 - (NSUInteger)maxBufferLength {return nmb_device_max_buffer_length(gDevice);}
@@ -4922,7 +4937,78 @@ static uint64_t askAnswer(SEL cmd,NSUInteger arg) {
 static NSUInteger countArgAnswer(id,SEL cmd,NSUInteger arg) {return (NSUInteger)askAnswer(cmd,arg);}
 static BOOL flagArgAnswer(id,SEL cmd,NSUInteger arg) {return askAnswer(cmd,arg)!=0;}
 static BOOL (*gFamilyAnswer)(id,SEL,NSInteger);
+#if TARGET_OS_OSX
+// iceland (macOS), boot-arg agx-mac-profile=1 or NATIVE_METAL_MAC_PROFILE=1 (off by default): the device presents itself as a Mac GPU of no
+// Apple family. supportsFamily: answers YES for Common1-3 and Mac2 only (not the target families Apple1-3 the runtime adds); function
+// pointers, dynamic libraries, ray tracing, SIMD-group and quad-group operations, tile shaders and image blocks are withheld; linear
+// textures get rows aligned to at least 64 bytes. On the tablet iconservicesagent aborted in Metal's MTLReportFailure under MPSImage, called
+// from Core Image's +[CIBlurProcessor processWithInputs:arguments:output:error:] (runs w2-stack-2 and w2-zleak-1). macos-uke (Xiaomi Pad 7,
+// A732, macOS 26.5, the same runtime family) found that with Apple families Core Image takes its Apple-GPU paths and icons, the Dock and the
+// wallpaper stay blank, and answers this profile; this is our own implementation of the same answers.
+static bool macProfile() {
+ static int on=-1;
+ if(on<0) {
+  const char *env=getenv("NATIVE_METAL_MAC_PROFILE");
+  char args[1024]={};size_t size=sizeof args-1;
+  on=(env && !strcmp(env,"1")) || (sysctlbyname("kern.bootargs",args,&size,nullptr,0)==0 && strstr(args,"agx-mac-profile=1"));
+ }
+ return on!=0;
+}
+static NSUInteger macLinearAlignment(id,SEL cmd,NSUInteger format) {
+ const NSUInteger own=(NSUInteger)askAnswer(cmd,format);
+ return own<64?64:own;
+}
+// The profile's fixed answers (installAnswers). featureProfile 10001 is Metal's ordinal of a Mac2 + Common1-3 GPU (0..13 are Apple GPU
+// ordinals; the shim's 0 is one of them), so Metal's own view of the device's families is the one supportsFamily: gives (SnapMetal
+// AdrenoMTLDevice.m: 10000 Common1/2, 10001 Mac2 + Common1-3, 10002 also Metal3). Metal, IconRendering, SkyLight, RenderBox and
+// CoreComposite read it on 26C5035r; _MTLGetMTLCompilerLLVMVersionForDevice reads it for a stitched library (below 8: the default
+// compiler version), which the profile's missing function pointers keep Core Image from building.
+static uint64_t macFeatureProfile(id,SEL) {return 10001;}
+static NSUInteger macSurfaceAlignment(id,SEL) {return 16;}
+static BOOL macNo(id,SEL) {return NO;}
+// Framebuffer fetch stays the runtime's own answer under the profile (yes on Turnip: it reads a color attachment in rasterization order).
+// The profile first answered NO, and the tablet's first desktop drawn wholly on the GPU (run w3-combined-1-datareset, 15 Nov) had every
+// round shape cut to a diamond (the login picture, the password field's ends), no login clock and a dark, opaque menu bar: Core Animation
+// restores the backdrop outside a clipping layer's rounded corners by reading the destination, and on a device without fetch it still
+// takes that path and writes the corner triangles; its blur, backdrop and blended materials read the destination the same way (SnapMetal
+// AdrenoMTLDevice.m, which answers YES with this same profile for that reason). Boot-arg agx-mac-fetch=0 or NATIVE_METAL_MAC_FETCH=0
+// answers NO again, with CA_DISABLE_GENERIC_SHADERS, to compare.
+static bool macFetch() {
+ static int on=-1;
+ if(on<0) {
+  const char *env=getenv("NATIVE_METAL_MAC_FETCH");
+  char args[1024]={};size_t size=sizeof args-1;
+  on=!((env && !strcmp(env,"0")) || (sysctlbyname("kern.bootargs",args,&size,nullptr,0)==0 && strstr(args,"agx-mac-fetch=0")));
+ }
+ return on!=0;
+}
+// Only where the device answers no framebuffer fetch (macFetch off, or a runtime without an ordered read). Core Animation's generic
+// pipeline blends in the shader through framebuffer fetch: it draws with it while a specialised pipeline compiles, and without fetch its
+// blur, backdrop and rounded corners come out black (SnapMetal). Its debug
+// option CA_DISABLE_GENERIC_SHADERS makes it wait for the specialised pipeline. Set in the environment (read at QuartzCore's first use)
+// and, where QuartzCore is loaded already, as the live option through its exported CAGetDebugOptionEnvVariableName / CASetDebugOption.
+// An explicit CA_DISABLE_GENERIC_SHADERS or CA_FORCE_GENERIC_SHADERS is left as it is.
+static void macDisableGenericShaders() {
+ static dispatch_once_t once;
+ dispatch_once(&once,^{
+  if(getenv("CA_DISABLE_GENERIC_SHADERS") || getenv("CA_FORCE_GENERIC_SHADERS"))return;
+  setenv("CA_DISABLE_GENERIC_SHADERS","1",0);
+  auto name=(const char *(*)(int))dlsym(RTLD_DEFAULT,"CAGetDebugOptionEnvVariableName");
+  auto set=(void (*)(int,bool))dlsym(RTLD_DEFAULT,"CASetDebugOption");
+  for(int i=0;name && set && i<4096;i++) {
+   const char *option=name(i);
+   if(!option)break;
+   if(strcmp(option,"CA_DISABLE_GENERIC_SHADERS"))continue;
+   dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE,0),^{set(i,true);});
+   break;
+  }
+ });
+}
+#endif
 static BOOL familyForCaller(id self,SEL _cmd,NSInteger family) {
+#if TARGET_OS_OSX
+ if(macProfile())return family==MTLGPUFamilyCommon1 || family==MTLGPUFamilyCommon2 || family==MTLGPUFamilyCommon3 || family==MTLGPUFamilyMac2;
+#endif
  if(family>=1003 && family<2000) {   // MTLGPUFamilyApple3 and up
   Dl_info caller;
   if(dladdr(__builtin_return_address(0),&caller) && caller.dli_fname && strstr(caller.dli_fname,"/RenderBox.framework/"))return NO;
@@ -5009,6 +5095,43 @@ static void installAnswers(Class cls) {
   gFamilyAnswer=(BOOL (*)(id,SEL,NSInteger))method_getImplementation(family);
   method_setImplementation(family,(IMP)familyForCaller);
  }
+#if TARGET_OS_OSX
+ // iceland (macOS): the Mac GPU profile's withheld features and its linear alignment (macProfile).
+ if(macProfile()) {
+  for(const char *name:{"supportsFunctionPointers","supportsFunctionPointersFromRender","supportsDynamicLibraries","supportsRenderDynamicLibraries",
+                         "supportsRaytracing","supportsRaytracingFromRender","supportsPrimitiveMotionBlur","supportsSIMDGroup","supportsSIMDReduction",
+                         "supportsSIMDShuffleAndFill","supportsSIMDGroupMatrix","supportsQuadGroup","supportsTileShaders","supportsImageBlocks"}) {
+   SEL sel=sel_registerName(name);
+   gAnswers[sel]=0;
+   if(!class_addMethod(cls,sel,(IMP)flagAnswer,"B16@0:8"))class_replaceMethod(cls,sel,(IMP)flagAnswer,"B16@0:8");
+  }
+  SEL linear=sel_registerName("minimumLinearTextureAlignmentForPixelFormat:");
+  if(!class_addMethod(cls,linear,(IMP)macLinearAlignment,"Q24@0:8Q16"))class_replaceMethod(cls,linear,(IMP)macLinearAlignment,"Q24@0:8Q16");
+  // installed here, before the IOGPU shim adds its featureProfile 0 (it adds only what the device does not answer)
+  const struct {const char *name;IMP imp;const char *types;} fixed[]={
+   {"featureProfile",(IMP)macFeatureProfile,"Q16@0:8"},
+   {"iosurfaceTextureAlignmentBytes",(IMP)macSurfaceAlignment,"Q16@0:8"},
+   {"deviceLinearReadOnlyTextureAlignmentBytes",(IMP)macSurfaceAlignment,"Q16@0:8"},
+   {"supportsMemorylessRenderTargets",(IMP)macNo,"B16@0:8"},
+  };
+  for(const auto &f:fixed) {
+   SEL sel=sel_registerName(f.name);
+   if(!class_addMethod(cls,sel,f.imp,f.types))class_replaceMethod(cls,sel,f.imp,f.types);
+  }
+  // Framebuffer fetch: the runtime's answer, installed by the loop above, stays (macFetch). Without one, or with agx-mac-fetch=0, the
+  // answer is NO and Core Animation waits for its specialised pipelines.
+  const SEL fetch=sel_registerName("isFramebufferReadSupported");
+  const auto own=gAnswers.find(fetch);
+  const bool fetches=macFetch() && own!=gAnswers.end() && own->second!=0;
+  if(!fetches) {
+   if(!class_addMethod(cls,fetch,(IMP)macNo,"B16@0:8"))class_replaceMethod(cls,fetch,(IMP)macNo,"B16@0:8");
+   macDisableGenericShaders();
+  }
+  GLOG(@"native-metal: Mac GPU profile (agx-mac-profile=1): Common1-3 and Mac2 (featureProfile 10001), no Apple family, linear rows of 64 "
+      "bytes or more, IOSurface and read-only linear alignment 16, no memoryless targets, framebuffer fetch %s",
+      fetches?"as the runtime answers (yes)":"NO (CA_DISABLE_GENERIC_SHADERS)");
+ }
+#endif
 }
 
