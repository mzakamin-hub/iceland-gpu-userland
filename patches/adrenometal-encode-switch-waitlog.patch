+// laneA: the value of a boot argument named exactly `name` (matched at the start of the command line or after a space), or
+// nullptr. kern.bootargs is the command line only (built-in kernel words are not in it).
+static const char *laneBootArgValue(const char *name,char *args,size_t size) {
+ size_t got=size-1;
+ if(sysctlbyname("kern.bootargs",args,&got,nullptr,0)!=0)return nullptr;
+ args[got<size?got:size-1]=0;
+ const size_t length=strlen(name);
+ for(const char *at=args;(at=strstr(at,name));at+=length)
+  if((at==args || at[-1]==' ') && at[length]=='=')return at+length+1;
+ return nullptr;
+}
+static bool laneBootArgIs(const char *name,const char *value) {
+ char args[1100]={};
+ const char *at=laneBootArgValue(name,args,sizeof args);
+ const size_t length=strlen(value);
+ return at && !strncmp(at,value,length) && (at[length]==0 || at[length]==' ');
+}
