+  {"texture_2d_array",MTLTextureType2DArray},{"texture_2d_ms",MTLTextureType2DMultisample},{"texture_cube",MTLTextureTypeCube},
+  {"texture_3d",MTLTextureType3D},{"depth_2d",MTLTextureType2D}};
+ static const std::pair<const char *,MTLBindingAccess> accesses[]={{"sample",MTLBindingAccessReadOnly},{"read",MTLBindingAccessReadOnly},
+  {"write",MTLBindingAccessWriteOnly},{"read_write",MTLBindingAccessReadWrite}};
+ NBFunctionTextureType *texture=[NBFunctionTextureType new];
+ bool kind=false,access=false;
+ for(auto &k:kinds)if(t.texture==k.first){texture.nbTextureType=k.second;kind=true;}
+ for(auto &a:accesses)if(t.access==a.first){texture.nbAccess=a.second;access=true;}
