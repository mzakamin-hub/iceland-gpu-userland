+// Apple's Metal for the qualified set (Metal 4.0 visible functions on macOS 27.2.1, QUAL.md): a value argument is binding kind 18 with
+// its MTLType, a struct 29, a texture 2 (its texel type and texture type on the binding too), a sampler 3 with no type, a pointer or
+// reference 28 with an MTLPointerType; a void result is data type 61. Members: a value or a sampler has no type object; a struct
+// member's struct has an empty typeName (the argument's struct names its own); a pointer member's element type object is data type 0
+// (an argument's is the element's).
+static MTLDataType reflectedScalar(const std::string &s) {
+ static const std::pair<const char *,MTLDataType> table[]={{"float",MTLDataTypeFloat},{"half",MTLDataTypeHalf},{"int",MTLDataTypeInt},
+  {"uint",MTLDataTypeUInt},{"short",MTLDataTypeShort},{"ushort",MTLDataTypeUShort},{"char",MTLDataTypeChar},{"uchar",MTLDataTypeUChar},
+  {"bool",MTLDataTypeBool},{"long",MTLDataTypeLong},{"ulong",MTLDataTypeULong}};
+ for(auto &entry:table)if(s==entry.first)return entry.second;
+ return MTLDataTypeNone;
+}
+// The data type of a scalar, vector or matrix (MTLDataTypeNone for anything else): a vector is its scalar's type plus lanes - 1, a
+// float or half matrix of C columns and R rows the 2x2 type plus 3 (C - 2) + (R - 2).
+static MTLDataType reflectedValueType(const air_signature::Type &t) {
+ using K=air_signature::Type;
+ if(t.kind==K::Scalar)return reflectedScalar(t.scalar);
+ if(t.kind==K::Vector && t.element) {
+  const MTLDataType base=reflectedScalar(t.element->scalar);
+  return base==MTLDataTypeNone?MTLDataTypeNone:(MTLDataType)(base+t.count-1);
+ }
+ if(t.kind==K::Matrix && t.element) {
+  const MTLDataType base=t.element->scalar=="float"?MTLDataTypeFloat2x2:t.element->scalar=="half"?MTLDataTypeHalf2x2:MTLDataTypeNone;
+  return base==MTLDataTypeNone?MTLDataTypeNone:(MTLDataType)(base+3*(t.columns-2)+(t.rows-2));
+ }
+ return MTLDataTypeNone;
+}
