+static NBFunctionStructType *reflectedStruct(const air_signature::Type &t,bool member,std::string &why,int depth) {
+ if(depth>8){why="structs nested too deep";return nil;}
+ NBFunctionStructType *type=[NBFunctionStructType new];
+ type.nbTypeName=member?@"":@(t.name.c_str());
+ if(!type.nbTypeName){why="a struct name that is not UTF-8";return nil;}
+ NSMutableArray *members=[NSMutableArray array];
+ for(const air_signature::Field &f:t.fields) {
+  NBFunctionStructMember *m=reflectedMember(f,why,depth);
+  if(!m)return nil;
+  [members addObject:m];
+ }
