+static NBFunctionArgument *reflectedArgument(const air_signature::Argument &a,std::string &why) {
+ using K=air_signature::Type;
+ const air_signature::Type &t=*a.type;
+ NBFunctionArgument *argument=[NBFunctionArgument new];argument.nbName=@(a.name.c_str());
+ if(!argument.nbName){why="an argument name that is not UTF-8";return nil;}
+ switch(t.kind) {
+  case K::Scalar:case K::Vector:case K::Matrix: {
+   const MTLDataType type=reflectedValueType(t);
+   if(type==MTLDataTypeNone){why="an argument value type outside the qualified set";return nil;}
+   argument.nbType=18;argument.nbDescription=reflectedPlainType(type);return argument;
+  }
+  case K::Struct:argument.nbType=29;argument.nbDescription=reflectedStruct(t,false,why);return argument.nbDescription?argument:nil;
+  case K::Sampler:argument.nbType=MTLBindingTypeSampler;return argument;
+  case K::Texture: {
+   if(t.access!="sample" && t.access!="read"){why="a texture argument written by the function (not qualified)";return nil;}
+   NBFunctionTextureType *texture=reflectedTexture(t,why);
+   if(!texture)return nil;
+   argument.nbType=MTLBindingTypeTexture;argument.nbDescription=texture;
+   argument.nbTextureDataType=texture.nbTexelType;argument.nbTextureType=texture.nbTextureType;argument.nbDepth=texture.nbDepth;
+   return argument;
+  }
+  case K::Pointer:case K::Reference:
+   argument.nbType=28;argument.nbDescription=reflectedPointer(t,false,why);return argument.nbDescription?argument:nil;
+  default:why="an argument of an unqualified kind";return nil;
+ }
+}
+// The signature of `function` (its own bitcode in its library's metallib) as Metal's objects, or false with the reason.
+static bool reflectFunction(NBFunction *function,id *result,NSArray **arguments,std::string &why) {
+ NSData *bitcode=function.library?functionBitcode(function):nil;
+ if(!bitcode){why=function.library?"its library has no bitcode under its name":"no library of its own (made without one)";return false;}
+ air_signature::Signature signature;
+ if(!air_signature::read((const uint8_t *)bitcode.bytes,bitcode.length,function.name.UTF8String?:"",signature,why))return false;
+ id made=reflectedResult(*signature.result,why);
