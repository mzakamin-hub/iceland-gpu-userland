+static id reflectedResult(const air_signature::Type &t,std::string &why) {
+ using K=air_signature::Type;
+ if(t.kind==K::Void)return reflectedPlainType((MTLDataType)61);
+ if(t.kind==K::Struct)return reflectedStruct(t,false,why);
+ const MTLDataType type=reflectedValueType(t);
+ if(type==MTLDataTypeNone){why="a result type outside the qualified set";return nil;}
+ return reflectedPlainType(type);
