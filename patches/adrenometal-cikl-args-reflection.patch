+  case K::Sampler:m.nbDataType=MTLDataTypeSampler;return m;
+  case K::Texture:m.nbDataType=MTLDataTypeTexture;m.nbDescription=reflectedTexture(t,why);return m.nbDescription?m:nil;
+  case K::Pointer:case K::Reference:m.nbDataType=MTLDataTypePointer;m.nbDescription=reflectedPointer(t,true,why);return m.nbDescription?m:nil;
+  case K::Struct:m.nbDataType=MTLDataTypeStruct;m.nbDescription=reflectedStruct(t,true,why,depth+1);return m.nbDescription?m:nil;
+  case K::Array: {
