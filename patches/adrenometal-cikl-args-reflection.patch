+static NBFunctionStructMember *reflectedMember(const air_signature::Field &f,std::string &why,int depth) {
+ using K=air_signature::Type;
+ const air_signature::Type &t=*f.type;
+ NBFunctionStructMember *m=[NBFunctionStructMember new];m.nbName=@(f.name.c_str());m.nbOffset=(NSUInteger)f.offset;
