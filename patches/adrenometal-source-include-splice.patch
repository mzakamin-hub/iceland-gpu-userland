# AdrenoMetal: Core Image's runtime kernels include "CIKernelMetalLibPrivate.h", a header that exists nowhere on this
# system as a file (its text lives inside CoreImage) and that Apple's in-process compiler does not resolve from the -I
# paths the request carries: Photo Booth's compile died on exactly that with -I/private/var/ngpu/ci-headers in request 13
# (cam15/cam15b, 19 Nov 2026). The add-on stages the carved header at /private/var/ngpu/ci-headers (icewl_hdr=1); when
# that file is readable the include line is rewritten to its absolute path in the source compileMetalSource hands the
# compiler, so the compiler needs no search path at all. Without the file the source is unchanged, so other boots keep
# today's behaviour. cam16 (19 Nov) showed the rewrite stays dormant for Photo Booth itself: the app runs under the app
# sandbox, so the in-process access() to /private/var/ngpu is denied and the compile answers the original 'file not
# found'; the mechanism stands for any client that can read the staged path. One hunk, inside compileMetalSource below
# the tessellation dump, far from the frameworks patch's hunks, so verify-pins' reverse checks pass in every order.
# Ours, MIT as the file it patches; applies after adrenometal-source-compile-frameworks.patch, on AdrenoMetal cc0a4e8e
# (R2507, the compile-options-dump patch dropped from the series 19 Nov: symbolication cleared it - the crash line's
# pc is the universal abort site ___pthread_kill+8, ESR 0x56000080 is the svc #0x80 syscall entry, not a tag check).
diff --git a/NativeBridgeMetalFrontend.mm b/NativeBridgeMetalFrontend.mm
index c91593e..c080181 100644
--- a/NativeBridgeMetalFrontend.mm
+++ b/NativeBridgeMetalFrontend.mm
@@ -871,6 +871,24 @@ static void dumpText(NSString *text) {NSData *bytes=[text dataUsingEncoding:NSUT
 static NSData *compileMetalSource(NSString *source,NSString *arguments,NSString **warnings,NSString **failure) {
  if(gDumpTessellation && [source containsString:@"[[patch"])
   dumpText([NSString stringWithFormat:@"\n=== native-metal tessellation source (options %@) ===\n%@\n=== end ===\n",arguments,source]);
+ // Core Image's runtime kernels include "CIKernelMetalLibPrivate.h": a header that exists nowhere on this system as a file (its
+ // text lives inside CoreImage) and that Apple's in-process compiler does not resolve from the -I paths the request carries (the
+ // cam15b request held -I/private/var/ngpu/ci-headers and the compile still answered 'file not found'). When the add-on has
+ // staged the carved header there (icewl_hdr=1) and this process can read it, the include is rewritten to that absolute path in
+ // the source the request carries, so the compiler needs no search path at all; without the file the source is unchanged.
+ if(!access("/private/var/ngpu/ci-headers/CIKernelMetalLibPrivate.h",R_OK)) {
+  NSString *absolute=@"#include \"/private/var/ngpu/ci-headers/CIKernelMetalLibPrivate.h\"";
+  NSMutableString *spliced=nil;
+  for(NSString *directive in @[@"#include \"CIKernelMetalLibPrivate.h\"",@"#include <CIKernelMetalLibPrivate.h>"]) {
+   if([source rangeOfString:directive].location==NSNotFound)continue;
+   if(!spliced)spliced=[source mutableCopy];
+   [spliced replaceOccurrencesOfString:directive withString:absolute options:NSLiteralSearch range:NSMakeRange(0,spliced.length)];
+  }
+  if(spliced) {
+   NBLOG(@"native-metal: spliced the Core Image runtime header include into the source (%lu -> %lu B)",(unsigned long)source.length,(unsigned long)spliced.length);
+   source=spliced;
+  }
+ }
  NSData *text=[source dataUsingEncoding:NSUTF8StringEncoding];
  const char *options=arguments.UTF8String;
  const uint64_t sourceBytes=(text.length+1+3)&~uint64_t(3),optionBytes=strlen(options)+1;
